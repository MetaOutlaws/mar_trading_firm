# =============================================================================
# Autonomous Crypto Trading Firm - environment template
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# =============================================================================

# ---- Trading mode -----------------------------------------------------------
# paper  : simulated fills against live mainnet prices (default, no funds at risk)
# testnet: real orders on Bybit testnet
# live   : real orders with real money. Requires GO_LIVE_CONFIRMED=I_ACCEPT_THE_RISK
TRADING_MODE=paper
GO_LIVE_CONFIRMED=

# ---- Bybit: TESTNET credentials --------------------------------------------
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# ---- Bybit: LIVE credentials ------------------------------------------------
# Keep these blank until the go-live gates pass. Separate keys from testnet on
# purpose so a config mistake cannot route a testnet run at real money.
BYBIT_LIVE_API_KEY=
BYBIT_LIVE_API_SECRET=

# ---- LLM providers ----------------------------------------------------------
# xAI powers the Sentiment Analyst (X/Twitter data). Requires a separate key.
XAI_API_KEY=
# Gemini serves cheap, standard, and strong employee tiers (paid quota).
GEMINI_API_KEY=
# Optional model overrides. Defaults: 3.5-flash-lite / 3.5-flash / 3.5-flash.
# LLM_MODEL_CHEAP=gemini-3.5-flash-lite
# LLM_MODEL_STANDARD=gemini-3.5-flash
# LLM_MODEL_STRONG=gemini-3.5-flash
# Unused unless you override a tier back to these providers.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# ---- LLM budget -------------------------------------------------------------
# Hard ceiling enforced by firm/runtime.py. The router degrades to cheaper
# models at 80% and pauses non-essential employees at 100%.
LLM_MONTHLY_BUDGET_USD=200

# ---- Historical data (BigQuery) --------------------------------------------
GCP_PROJECT_ID=crypto-bot-472419
BIGQUERY_DATASET=historical_data
GOOGLE_APPLICATION_CREDENTIALS=

# ---- Storage ----------------------------------------------------------------
# SQLAlchemy URL. SQLite (WAL) locally; swap for postgresql+psycopg:// in cloud.
DATABASE_URL=sqlite:///data/firm.db

# ---- API / dashboard --------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Shared secret required by state-changing API endpoints (kill switch, approvals).
API_TOKEN=change-me-to-a-long-random-string

# ---- Research pipeline continuity -------------------------------------------
# Tier A walk-forwards start without Inbox. Paper-to-live is still a hard human
# gate. Set false to revert every research step to default-block.
PIPELINE_AUTO_ADVANCE=true
# Same-grid cap per 24h. A new family@clock@side still auto-starts.
PIPELINE_AUTO_ADVANCE_BUDGET_24H=48
PIPELINE_CIRCUIT_BREAKER_REJECTS=3
# Concurrent validators. Lower this if Bybit rate-limits.
PIPELINE_WF_PARALLELISM=3
PIPELINE_CATALOG_MIN_UNQUEUED=10
# Brief asked for a floor of 2 uncoded families. Default 0: code immediately.
PIPELINE_CODING_QUEUE_FLOOR=0
PIPELINE_CODING_QUEUE_CAP=5
PIPELINE_STANDBY_FLOOR=1
PIPELINE_STANDBY_TARGET=2
PIPELINE_TIER_B_HOURS=24
PIPELINE_MAX_FREE_PARAMS=6
PIPELINE_REJECT_COOLDOWN_DAYS=30

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
