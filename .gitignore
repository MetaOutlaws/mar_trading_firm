# ---- Secrets: never commit ----
.env
.env.*
!.env.example
*.key
*.pem
credentials.json
service-account*.json
gcp-*.json

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Data & runtime state ----
# The firm database is machine-local runtime state, not source.
data/*.db
data/*.db-wal
data/*.db-shm
data/cache/
# Luke CT scraper snapshot (example file is committed).
data/last_sentiment.json
data/last_sentiment.json.tmp
# Live Soko trend hook (example is not required; paper fail-closes if missing).
data/last_soko_trend.json
data/last_soko_trend.json.tmp
# Paper cash / event journal (F02). Back up with firm.db; do not commit.
data/paper_cash.json
data/paper_cash.json.tmp
# Last evaluated 1h/4h bar per paper sleeve. Runtime cursor, not source.
data/paper_bar_eval_state.json
data/paper_bar_eval_state.json.tmp
# Deployed commit stamp for the dashboard. The image has no .git.
# See docs/runbooks/desk_deployed_sha.md.
/GIT_SHA
data/DEPLOYED_SHA
logs/*.log
logs/*.log.*
logs/archive/

# ---- Research artifacts ----
# Reports are reproducible from code + BigQuery; keep the repo lean.
research/artifacts/
*.parquet

# ---- Node / Next.js dashboard ----
node_modules/
.next/
out/
dashboard/.env.local

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
